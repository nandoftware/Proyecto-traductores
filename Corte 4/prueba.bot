create
    int bot contador
        on activation:
            store 3.
        end

        on me > 0:
            send.
            store me - 1.
        end

        on default:
            store 0.
        end

        on deactivation:
            send.
        end
    end
execute
    activate contador.

    while contador > 0:
        advance contador.
    end

    deactivate contador.
end